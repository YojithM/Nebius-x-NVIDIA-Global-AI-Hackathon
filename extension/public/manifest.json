{
  "manifest_version": 3,
  "name": "Cadence — study assistant",
  "version": "0.8.0",
  "description": "Click to talk. A calm study assistant that knows your classes, deadlines, and weak topics.",
  "minimum_chrome_version": "116",

  "permissions": ["sidePanel", "activeTab", "scripting", "alarms", "notifications", "storage"],

  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*",
    "https://*.nebius.cloud/*"
  ],

  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_title": "Open Cadence"
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
